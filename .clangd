# Shared by every OS. One fragment is an optional If plus sibling blocks.
# Separate fragments with ---. https://clangd.llvm.org/config.html
#
# Compiler path and system includes stay out of this file. clangd 22 has no
# OS condition. On Linux the host libstdc++ is found automatically. The MSYS2
# compiler and -isystem paths belong in %LocalAppData%\clangd\config.yaml.

CompileFlags:
  CompilationDatabase: build
  Add:
    - -Iinclude
    - -ferror-limit=0
    - -Wall
    - -Wextra

---
If:
  PathMatch: .*\.(cpp|hpp|h)
CompileFlags:
  Add: [-std=c++17]

---
If:
  PathMatch: .*\.c
CompileFlags:
  # Nearest command is g++, so the file stays C++ until -xc.
  Remove: [-std=c++17]
  Add: [-xc, -std=c11, -Wno-unknown-attributes]
